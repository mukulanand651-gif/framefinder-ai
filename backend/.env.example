
# ==========================================
# FRAMEFINDER AI - DEVELOPMENT CONFIGURATION
# ==========================================

# SERVER
PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# DATABASE - NEON POSTGRESQL
DATABASE_URL=YOUR_NEON_DATABASE_URL
DATABASE_SSL=true

# APPLICATION MODE
DEMO_MODE=false

# ==========================================
# GEMINI - PRODUCT IMAGE ANALYSIS
# ==========================================

VISION_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_MIN_INTERVAL_MS=7000
GEMINI_REQUEST_TIMEOUT_MS=70000

# VERIFICATION
MIN_MATCH_SCORE=60
REQUIRE_VISUAL_VERIFICATION=true
REQUIRE_CONFIRMED_REELS=true

# ==========================================
# PRODUCT DISCOVERY
# ==========================================

PRODUCT_DISCOVERY_PROVIDER=selfhosted

# No SerpApi key required.
# No PRODUCT_STORE_URLS required.
# Keyword discovery uses your indexed catalog.

# ==========================================
# VIDEO COLLECTION - SELF-HOSTED PLAYWRIGHT
# ==========================================

VIDEO_PROVIDER=selfhosted
SELFHOSTED_META_COUNTRY=US

# ==========================================
# SEARCH LIMITS
# ==========================================

MAX_SOURCE_PASSES=4
APIFY_CANDIDATE_LIMIT=30

MAX_VISION_CHECKS_PER_SOURCE=8
RESULTS_PER_SOURCE=20
UNVERIFIED_PREVIEW_LIMIT=20

# RELEVANCE FILTERING
STRICT_BRAND_TEXT_MATCH=false
MIN_TEXT_RELEVANCE=0

# ==========================================
# BACKGROUND WORKER
# ==========================================

WORKER_POLL_MS=2500
VIDEO_PROVIDER=selfhosted

SELFHOSTED_META_COUNTRY=US
SELFHOSTED_SCROLLS=4
SELFHOSTED_HEADLESS=true
SELFHOSTED_DEBUG=false

MAX_SOURCE_PASSES=4
APIFY_CANDIDATE_LIMIT=30

REQUIRE_CONFIRMED_REELS=true
REQUIRE_VISUAL_VERIFICATION=true
DEMO_MODE=false